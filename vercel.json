{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "zh/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "og.*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/check(?:\\.js)?/?",
      "dest": "/api/check.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/zh/?",
      "dest": "/zh/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
